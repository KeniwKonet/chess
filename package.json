{
  "name": "chessfront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @cr/web",
    "build": "npm run build -w @cr/web && node tools/copy-dist.mjs",
    "preview": "npm run preview -w @cr/web",
    "server": "npm run start -w @cr/server",
    "assets": "node tools/build-assets.mjs",
    "test": "vitest run",
    "typecheck": "npm exec --workspaces -- tsc --noEmit"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "meshoptimizer": "1.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  }
}
